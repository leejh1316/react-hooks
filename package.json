{
  "name": "react-hooks",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm run build:packages && pnpm --filter demo build",
    "preview": "pnpm run build:packages && pnpm --filter demo preview",
    "dev:example": "pnpm --filter example dev",
    "build:example": "pnpm run build:packages && pnpm --filter example build",
    "dev:docs": "pnpm --filter react-hooks-docs dev",
    "preview:docs": "pnpm --filter react-hooks-docs preview",
    "build:docs": "pnpm --filter react-hooks-docs build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:use-focus-trap": "pnpm --filter use-focus-trap build",
    "build:use-roving-focus": "pnpm --filter use-roving-focus build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.31",
      "@types/react-dom": "18.3.7"
    }
  }
}
